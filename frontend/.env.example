# Base URL of the TaskFlow API — your BACKEND Vercel project URL, no trailing slash.
# Leave empty in local development (Vite proxies /api and /socket.io to http://localhost:4000).
# Production example: https://taskflow-api.vercel.app
VITE_API_URL=

# Optional (defaults shown):
# VITE_SOCKET_PATH=/socket.io
# Must match the backend MAX_UPLOAD_MB. Use 4 on Vercel (4.5 MB request limit).
# VITE_MAX_UPLOAD_MB=25
