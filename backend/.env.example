# ============================================================================
# TaskFlow backend environment. Copy to backend/.env for local development.
# On Vercel, set the same names under Project → Settings → Environment Variables.
# NEVER commit real values.
# ============================================================================

# ---- Required ---------------------------------------------------------------
# Neon POOLED connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon DIRECT connection string (no "-pooler"). Used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
# Long random string (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string-at-least-32-characters"
# Local dev server port (ignored on Vercel).
PORT=4000
# Comma-separated allowed frontend origins. Wildcards allowed, e.g. https://*.vercel.app
CORS_ORIGINS=http://localhost:5173

# ---- Optional (defaults shown) ----------------------------------------------
# NODE_ENV=development
# JWT_EXPIRES_IN=12h
# ALLOW_SIGNUP=true            # first sign-up becomes Admin; later sign-ups are Developers
# AUTH_RATE_LIMIT=30           # login/signup attempts per IP per 15 minutes
# UPLOAD_DIR=./uploads         # local disk storage (development)
# MAX_UPLOAD_MB=25             # defaults to 4 on Vercel (4.5 MB request body limit)
# STORAGE_DRIVER=local         # 'local' or 'vercel-blob' (auto when a Blob store is connected)
# REDIS_URL=                   # Redis for Socket.IO across Vercel instances (recommended in production)
# CRON_SECRET=                 # protects /api/cron/due-dates (Vercel Cron sends it automatically)
# SOCKET_PATH=/socket.io

# ---- Development seed only (npm run db:seed) ----------------------------------
SEED_PASSWORD=ChangeMe123!

# ---- Production admin bootstrap (npm run create-admin) ----------------------
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=a-strong-password-123
# ADMIN_NAME="Your Name"
