# ---- Server ----
NODE_ENV=development
PORT=4000

# ---- Database (PostgreSQL / Neon) ----
# Neon: DATABASE_URL = POOLED connection string (host contains "-pooler"), DIRECT_URL = direct connection string.
# Local Docker Postgres: use the same URL for both.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN=12h
# Allow public sign-up (first account always becomes Admin; later sign-ups become Developer)
ALLOW_SIGNUP=true

# ---- CORS ----
# Comma-separated list of allowed frontend origins. Wildcards allowed, e.g. https://*.vercel.app
CORS_ORIGINS=http://localhost:5173

# ---- Uploads ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# ---- Seed (development only) ----
SEED_PASSWORD=ChangeMe123!

# ---- Production admin bootstrap (npm run create-admin) ----
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=a-strong-password-123
# ADMIN_NAME="Your Name"
AUTH_RATE_LIMIT=30
